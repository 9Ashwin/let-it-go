__pycache__/
*.pyc

# eval：结果就是证据，进库（每轮的 grading.json / benchmark / notes 都留着）
evals/harness/evalctl
evals/harness/evals

# 臂的工作副本是 scratch（整个仓库副本 + .git + 本地 origin），不进库。
# 留在原处是为了复核：分数在 grading.json 里，产物在 work/ 里。
evals/results/**/work
evals/results/**/work.origin.git
evals/results/**/work.seed.json

# eval 跑出来的产物：work/ 里是 fixture 的 git 仓库，不进版本库
**/results/**/work/
**/results/iteration-*/**/work/
